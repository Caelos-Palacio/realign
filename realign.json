{
  "version": 1,
  "rules": [
    {
      "id": "example-version",
      "kind": "derived",
      "source": "examples/manifest.json",
      "pointer": "/version",
      "target": "README.md",
      "template": "Example version: {value}"
    },
    {
      "id": "example-version-es",
      "kind": "derived",
      "source": "examples/manifest.json",
      "pointer": "/version",
      "target": "README.es.md",
      "template": "Versión del ejemplo: {value}"
    }
  ]
}
